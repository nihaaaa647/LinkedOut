<%- include('partials/header') %>

<div class="panel auth-panel">
  <h1 style="font-size:1.15rem;">Log in</h1>
  <p class="subtitle muted" style="margin-bottom:1.25rem;">Access your applications and saved internships.</p>
  <form method="POST" action="/login">
    <label>Email</label>
    <input type="email" name="email" required autofocus />
    <label>Password</label>
    <input type="password" name="password" required />
    <button type="submit" style="width:100%;">Log in</button>
  </form>
  <p class="muted" style="margin-top:1.1rem; text-align:center;">No account yet? <a href="/register">Create one</a></p>
</div>

<%- include('partials/footer') %>
