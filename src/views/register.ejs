<%- include('partials/header') %>

<div class="panel auth-panel" style="max-width:420px;">
  <h1 style="font-size:1.15rem;">Create an account</h1>
  <p class="subtitle muted" style="margin-bottom:1.25rem;">Set up your student profile to see match scores and apply.</p>
  <form method="POST" action="/register">
    <label>Full name</label>
    <input type="text" name="name" required autofocus />
    <label>Email</label>
    <input type="email" name="email" required />
    <label>Password</label>
    <input type="password" name="password" minlength="8" required />
    <p class="muted" style="margin-top:-0.6rem; margin-bottom:0.9rem; font-size:0.78rem;">At least 8 characters.</p>
    <div class="field-row cols-2">
      <div>
        <label>Branch</label>
        <input type="text" name="branch" placeholder="CSE" />
      </div>
      <div>
        <label>Year</label>
        <input type="number" name="year" min="1" max="6" />
      </div>
    </div>
    <label>CGPA</label>
    <input type="number" step="0.1" name="cgpa" min="0" max="10" />
    <button type="submit" style="width:100%;">Create account</button>
  </form>
  <p class="muted" style="margin-top:1.1rem; text-align:center;">Already registered? <a href="/login">Log in</a></p>
</div>

<%- include('partials/footer') %>
