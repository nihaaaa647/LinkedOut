<%- include('partials/header') %>

<div class="card" style="max-width: 440px; margin: 2rem auto;">
  <h3>Register</h3>
  <form method="POST" action="/register">
    <label>Name</label>
    <input type="text" name="name" required />
    <label>Email</label>
    <input type="email" name="email" required />
    <label>Password (min 8 characters)</label>
    <input type="password" name="password" minlength="8" required />
    <div class="grid cols-2">
      <div>
        <label>Branch</label>
        <input type="text" name="branch" placeholder="CSE" />
      </div>
      <div>
        <label>Year</label>
        <input type="number" name="year" min="1" max="6" />
      </div>
    </div>
    <label>CGPA</label>
    <input type="number" step="0.1" name="cgpa" min="0" max="10" />
    <button type="submit">Register</button>
  </form>
  <p class="muted" style="margin-top:1rem;">Already have an account? <a href="/login">Login</a></p>
</div>

<%- include('partials/footer') %>
