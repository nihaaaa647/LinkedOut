<%- include('../partials/header') %>

<h2>All Applications</h2>

<form method="GET" action="/admin/applications" class="card">
  <label>Filter by status</label>
  <select name="status" class="auto-submit">
    <option value="">All</option>
    <% ["Applied", "Shortlisted", "Rejected", "Selected", "Withdrawn"].forEach(function (s) { %>
      <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
</form>

<table>
  <thead><tr><th>Student</th><th>Internship</th><th>Status</th><th>Applied</th><th>Update status</th></tr></thead>
  <tbody>
    <% applications.forEach(function (a) { %>
      <tr>
        <td><%= a.userId ? a.userId.name + ' (' + a.userId.email + ')' : '' %></td>
        <td><%= a.internshipId ? a.internshipId.title : '' %></td>
        <td><span class="badge <%= a.status.toLowerCase() %>"><%= a.status %></span></td>
        <td class="muted"><%= new Date(a.appliedAt).toLocaleDateString() %></td>
        <td>
          <% if (!["Rejected", "Selected", "Withdrawn"].includes(a.status)) { %>
            <form class="inline" method="POST" action="/admin/applications/<%= a._id %>/status">
              <select name="status" class="auto-submit" style="width:auto; display:inline-block; margin:0;">
                <option value="">Change to…</option>
                <option value="Shortlisted">Shortlisted</option>
                <option value="Rejected">Rejected</option>
                <option value="Selected">Selected</option>
              </select>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (applications.length === 0) { %><tr><td colspan="5" class="muted">No applications match this filter.</td></tr><% } %>
  </tbody>
</table>

<%- include('../partials/footer') %>
