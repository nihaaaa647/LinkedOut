<%- include('../partials/header') %>

<h2>Review Queue</h2>
<p class="muted">Scraped listings routed here by the trust score, a low-confidence eligibility parse, or community reports.</p>

<div class="grid">
  <% pending.forEach(function (i) { %>
    <div class="card">
      <h3><%= i.title %> <span class="muted">— <%= i.company %></span></h3>
      <p class="muted"><%= i.location %> · deadline <%= new Date(i.deadline).toLocaleDateString() %></p>
      <p><%= i.description %></p>
      <p>
        <span class="badge <%= i.trustScore >= 70 ? 'success' : i.trustScore >= 40 ? 'warning' : 'danger' %>">trustScore: <%= i.trustScore %></span>
        <% if (i.eligibilityConfident === false) { %><span class="badge danger">low-confidence eligibility</span><% } %>
        <% if (i.reportReasons && i.reportReasons.length) { %><span class="badge danger"><%= i.reportReasons.length %> report(s): <%= i.reportReasons.join(', ') %></span><% } %>
      </p>
      <div style="display:flex; gap:0.5rem;">
        <form method="POST" action="/admin/internships/<%= i._id %>/approve"><button type="submit">Approve</button></form>
        <form method="POST" action="/admin/internships/<%= i._id %>/reject"><button class="danger" type="submit">Reject</button></form>
      </div>
    </div>
  <% }) %>
  <% if (pending.length === 0) { %><p class="muted">Nothing pending review right now.</p><% } %>
</div>

<%- include('../partials/footer') %>
