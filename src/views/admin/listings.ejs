<%- include('../partials/header') %>

<h2>Manage Listings</h2>

<div class="card">
  <h3>Create a listing</h3>
  <form method="POST" action="/admin/internships">
    <div class="grid cols-2">
      <div><label>Title</label><input type="text" name="title" required /></div>
      <div><label>Company</label><input type="text" name="company" required /></div>
    </div>
    <label>Description</label>
    <textarea name="description" rows="3" required></textarea>
    <div class="grid cols-2">
      <div><label>Location</label><input type="text" name="location" required /></div>
      <div><label>Deadline</label><input type="datetime-local" name="deadline" required /></div>
    </div>
    <div class="grid cols-2">
      <div><label>Stipend (optional)</label><input type="number" name="stipend" /></div>
      <div>
        <label>Work mode</label>
        <select name="workMode">
          <option value="">-</option>
          <option value="remote">Remote</option>
          <option value="hybrid">Hybrid</option>
          <option value="onsite">Onsite</option>
        </select>
      </div>
    </div>
    <label>Required skills (comma-separated)</label>
    <input type="text" name="requiredSkills" placeholder="JavaScript, Docker" />
    <div class="grid cols-2">
      <div><label>Eligible branches (comma-separated, or "Any")</label><input type="text" name="branches" placeholder="CSE, IT" /></div>
      <div><label>Eligible years (comma-separated)</label><input type="text" name="years" placeholder="3, 4" /></div>
    </div>
    <label>Minimum CGPA</label>
    <input type="number" step="0.1" name="minCgpa" />
    <button type="submit">Create listing</button>
  </form>
</div>

<h3>All listings</h3>
<table>
  <thead><tr><th>Title</th><th>Company</th><th>Status</th><th>Deadline</th><th>Source</th><th></th></tr></thead>
  <tbody>
    <% internships.forEach(function (i) { %>
      <tr>
        <td><a href="/internships/<%= i._id %>"><%= i.title %></a></td>
        <td><%= i.company %></td>
        <td><span class="badge <%= i.status %>"><%= i.status %></span></td>
        <td class="muted"><%= new Date(i.deadline).toLocaleDateString() %></td>
        <td class="muted"><%= i.sourceType %><% if (i.trustScore !== undefined && i.trustScore !== null) { %> (score <%= i.trustScore %>)<% } %></td>
        <td>
          <% if (i.status === "published") { %>
            <form class="inline" method="POST" action="/admin/internships/<%= i._id %>/close"><button class="secondary" type="submit">Close</button></form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>
