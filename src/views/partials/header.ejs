<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== "undefined" ? title + " · Internship Portal" : "Internship Portal" %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<%
  // Minimal 18x18 line-icon path data, reused across the sidebar nav below.
  const icons = {
    search: '<path d="M8.5 15a6.5 6.5 0 1 1 0-13 6.5 6.5 0 0 1 0 13Zm9 2-4.35-4.35"/>',
    list: '<path d="M8 5h9M8 10h9M8 15h9M4 5h.01M4 10h.01M4 15h.01"/>',
    user: '<path d="M9 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-6 9c0-3.3 2.7-6 6-6s6 2.7 6 6"/>',
    bell: '<path d="M5 8a4 4 0 0 1 8 0c0 3.2.8 4.4 1.5 5H3.5c.7-.6 1.5-1.8 1.5-5Z"/><path d="M7.3 15.5a1.7 1.7 0 0 0 3.4 0"/>',
    briefcase: '<rect x="2.5" y="6.5" width="13" height="9" rx="1.5"/><path d="M6.5 6.5V5a1.5 1.5 0 0 1 1.5-1.5h2A1.5 1.5 0 0 1 11.5 5v1.5"/>',
    flag: '<path d="M4 15.5V3"/><path d="M4 4h8.5l-2 3 2 3H4"/>',
    clipboardCheck: '<rect x="4" y="3.5" width="10" height="12" rx="1.2"/><path d="M6.8 2.5h4.4a.6.6 0 0 1 .6.6v1a.6.6 0 0 1-.6.6H6.8a.6.6 0 0 1-.6-.6v-1a.6.6 0 0 1 .6-.6Z"/><path d="m6.7 9.5 1.8 1.8 3-3.3"/>',
    chart: '<path d="M3 15.5h12"/><path d="M6 15.5v-4M9.5 15.5v-7M13 15.5v-9.5"/>',
    logout: '<path d="M7 3.5H4.5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1H7"/><path d="M11 12.5 15 9l-4-3.5"/><path d="M15 9H6.5"/>',
  };
  // `linkify` itself comes from res.locals (set in viewAuth.js's attachViewUser) rather
  // than being declared here, since EJS's include() doesn't leak a sub-template's own
  // local declarations back into the templates that include it.
%>
<div class="app-shell">
<% if (currentUser) { %>
  <aside class="sidebar">
    <a class="brand" href="/internships">Internship Portal</a>
    <nav>
      <% if (currentUser.role === "user") { %>
        <a class="nav-link <%= currentPath === '/internships' ? 'active' : '' %>" href="/internships">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons.search %></svg>
          Browse
        </a>
        <a class="nav-link <%= currentPath === '/applications' ? 'active' : '' %>" href="/applications">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons.list %></svg>
          My Applications
        </a>
        <a class="nav-link <%= currentPath === '/profile' ? 'active' : '' %>" href="/profile">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons.user %></svg>
          Profile
        </a>
        <a class="nav-link <%= currentPath === '/notifications' ? 'active' : '' %>" href="/notifications">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons.bell %></svg>
          Notifications
        </a>
      <% } else { %>
        <span class="nav-section-label">Listings</span>
        <a class="nav-link <%= currentPath === '/admin/internships' ? 'active' : '' %>" href="/admin/internships">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons.briefcase %></svg>
          Manage Listings
        </a>
        <a class="nav-link <%= currentPath === '/admin/internships/pending' ? 'active' : '' %>" href="/admin/internships/pending">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons.flag %></svg>
          Review Queue
        </a>
        <span class="nav-section-label">Students</span>
        <a class="nav-link <%= currentPath === '/admin/applications' ? 'active' : '' %>" href="/admin/applications">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons.clipboardCheck %></svg>
          Applications
        </a>
        <a class="nav-link <%= currentPath === '/admin/analytics' ? 'active' : '' %>" href="/admin/analytics">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons.chart %></svg>
          Skill-Gap Analytics
        </a>
      <% } %>
    </nav>
    <div class="sidebar-footer">
      <div class="user-name"><%= currentUser.name %></div>
      <div class="user-email"><%= currentUser.email %></div>
      <form method="POST" action="/logout">
        <button class="secondary" type="submit" style="width:100%; display:flex; align-items:center; justify-content:center; gap:0.5rem;">
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons.logout %></svg>
          Log out
        </button>
      </form>
    </div>
  </aside>
<% } %>

  <div class="main-column">
    <% if (!currentUser) { %>
      <header class="topbar">
        <a class="brand" href="/internships">Internship Portal</a>
        <div class="topbar-actions">
          <div class="topbar-links">
            <a href="/internships">Browse</a>
          </div>
          <a class="btn secondary" href="/login">Log in</a>
          <a class="btn" href="/register">Register</a>
        </div>
      </header>
    <% } %>
    <div class="content">
      <% if (flashError) { %><div class="flash error"><%= flashError %></div><% } %>
      <% if (flashSuccess) { %><div class="flash success"><%= flashSuccess %></div><% } %>
