<%- include('../partials/header') %>

<h2>My Profile</h2>

<div class="grid cols-2">
  <div class="card">
    <h3>Details</h3>
    <form method="POST" action="/profile">
      <label>Branch</label>
      <input type="text" name="branch" value="<%= profile.branch || '' %>" />
      <label>Year</label>
      <input type="number" name="year" min="1" max="6" value="<%= profile.year || '' %>" />
      <label>CGPA</label>
      <input type="number" step="0.1" name="cgpa" min="0" max="10" value="<%= profile.cgpa || '' %>" />
      <label>Preferred location</label>
      <input type="text" name="locationPreference" value="<%= profile.locationPreference || '' %>" />
      <label>Skills (comma-separated)</label>
      <input type="text" name="skills" value="<%= (profile.skills || []).join(', ') %>" />
      <button type="submit">Save profile</button>
    </form>
  </div>

  <div class="card">
    <h3>Resume</h3>
    <% if (profile.resumeOriginalName) { %>
      <p>Current: <%= profile.resumeOriginalName %> <span class="muted">(uploaded <%= new Date(profile.resumeUploadedAt).toLocaleDateString() %>)</span></p>
    <% } else { %>
      <p class="muted">No resume uploaded yet.</p>
    <% } %>
    <form method="POST" action="/profile/resume" enctype="multipart/form-data">
      <label>Upload / replace resume (PDF, DOC, DOCX, max 2MB)</label>
      <input type="file" name="resume" accept=".pdf,.doc,.docx" required />
      <button type="submit">Upload</button>
    </form>
    <p class="muted">Uploading auto-detects skills from a PDF resume and adds them to your profile - your manually entered skills are never removed by this.</p>
  </div>
</div>

<%- include('../partials/footer') %>
