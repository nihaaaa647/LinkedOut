<%- include('../partials/header') %>

<div class="page-header">
  <h1>My profile</h1>
  <p class="subtitle">Kept up to date, your skills drive match scores across every listing.</p>
</div>

<div class="field-row cols-2">
  <div class="panel">
    <div class="panel-title">Details</div>
    <form method="POST" action="/profile">
      <label>Branch</label>
      <input type="text" name="branch" value="<%= profile.branch || '' %>" />
      <div class="field-row cols-2">
        <div>
          <label>Year</label>
          <input type="number" name="year" min="1" max="6" value="<%= profile.year || '' %>" />
        </div>
        <div>
          <label>CGPA</label>
          <input type="number" step="0.1" name="cgpa" min="0" max="10" value="<%= profile.cgpa || '' %>" />
        </div>
      </div>
      <label>Preferred location</label>
      <input type="text" name="locationPreference" value="<%= profile.locationPreference || '' %>" />
      <label>Skills</label>
      <input type="text" name="skills" value="<%= (profile.skills || []).join(', ') %>" placeholder="JavaScript, React, SQL" />
      <p class="muted" style="margin-top:-0.6rem; font-size:0.78rem;">Comma-separated. Used to compute your match score on every listing.</p>
      <button type="submit">Save profile</button>
    </form>
  </div>

  <div class="panel">
    <div class="panel-title">Resume</div>
    <% if (profile.resumeOriginalName) { %>
      <p class="muted"><%= profile.resumeOriginalName %><br />uploaded <%= new Date(profile.resumeUploadedAt).toLocaleDateString() %></p>
    <% } else { %>
      <p class="muted">No resume uploaded yet.</p>
    <% } %>
    <form method="POST" action="/profile/resume" enctype="multipart/form-data">
      <label>Upload / replace (PDF, DOC, DOCX — max 2MB)</label>
      <input type="file" name="resume" accept=".pdf,.doc,.docx" required />
      <button type="submit" class="secondary">Upload</button>
    </form>
    <p class="muted" style="font-size:0.78rem; margin-top:0.75rem; margin-bottom:0;">Uploading auto-detects skills from a PDF and adds them to your profile — nothing you've entered manually is ever removed.</p>
  </div>
</div>

<%- include('../partials/footer') %>
