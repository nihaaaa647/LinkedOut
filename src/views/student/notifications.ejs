<%- include('../partials/header') %>

<h2>Notifications</h2>

<div class="grid">
  <% notifications.forEach(function (n) { %>
    <div class="card" style="<%= n.read ? 'opacity:0.6;' : '' %>">
      <span class="badge <%= n.type === 'match_alert' ? 'success' : 'warning' %>"><%= n.type === 'match_alert' ? 'Match alert' : 'Deadline reminder' %></span>
      <p>
        <% if (n.internshipId) { %>
          <a href="/internships/<%= n.internshipId._id %>"><%= n.internshipId.title %></a> at <%= n.internshipId.company %>
          <% if (n.internshipId.deadline) { %> — deadline <%= new Date(n.internshipId.deadline).toLocaleString() %><% } %>
        <% } else { %>(listing removed)<% } %>
      </p>
      <p class="muted"><%= new Date(n.createdAt).toLocaleString() %></p>
      <% if (!n.read) { %>
        <form method="POST" action="/notifications/<%= n._id %>/read"><button class="secondary" type="submit">Mark as read</button></form>
      <% } %>
    </div>
  <% }) %>
  <% if (notifications.length === 0) { %><p class="muted">No notifications yet.</p><% } %>
</div>

<%- include('../partials/footer') %>
