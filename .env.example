PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/internship_portal
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1h
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:5173

NOTIFY_WINDOW_HOURS=48
NOTIFY_CRON=0 */6 * * *
SCRAPE_CRON=0 */6 * * *
MATCH_ALERT_THRESHOLD=85
REPORT_THRESHOLD=3
MAX_RESUME_SIZE_MB=2
